// SalesAnalysis.Web/appsettings.json
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Блок для зберігання рядків підключення
  "ConnectionStrings": {
    // Назва "DefaultConnection" використовується в Program.cs для налаштування EF Core
    // Data Source=SalesData.db вказує, що файл БД буде створений/знаходитися 
    // у кореневій директорії проєкту (біля .exe файлу) і називатиметься SalesData.db
    "DefaultConnection": "Data Source=SalesData.db;Pooling=False;Cache=Shared"
  }
}